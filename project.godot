window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://documents/": "red",
"res://objects/": "orange",
"res://scenes/": "yellow",
"res://scripts/": "green",
"res://ui/": "blue"
}
